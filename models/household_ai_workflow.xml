      <manipulate id="a10" label="Build Tasks from Submissions">
        <code>submissions = [
  data.task_submission_1,
  data.task_submission_2,
  data.task_submission_3
]

data.tasks = []

submissions.each_with_index do |submission, index|
  submission = JSON.parse(submission) if submission.is_a?(String)

  unless submission.is_a?(Hash)
    raise "Invalid task submission #{index + 1}"
  end

  form_data = submission['data']
  form_data = submission if !form_data.is_a?(Hash)

  area = form_data['area'].to_s.strip
  task = form_data['task'].to_s.strip
  urgency = form_data['urgency'].to_s.strip

  label = [task, area].reject(&amp;:empty?).join(' - ')
  raise "Task label missing in submission #{index + 1}" if label.empty?

  estimated_minutes =
    case urgency.downcase
    when 'urgent', 'high'
      45
    when 'next_week'
      20
    else
      30
    end

  data.tasks &lt;&lt; {
    'task_id' =&gt; "household_task_#{index + 1}",
    'label' =&gt; label,
    'estimated_minutes' =&gt; estimated_minutes
  }
end</code>
